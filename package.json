{
  "name": "@lumen-build/sync-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run && bun test .bun.test.ts",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "1.3.4",
    "effect": "4.0.0-beta.102",
    "oauth2-mock-server": "9.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.76.0",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "vitest": "4.0.17"
  },
  "packageManager": "bun@1.3.4"
}
